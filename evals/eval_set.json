    "clarify": "a question back to the person before answering",
    "nutrition_fact": "numbers for a food or dish",
    "food_guidance": "whether or how a food fits the programme",
    "recipe": "one recipe with ingredients and steps",
    "recipe_list": "a list of dishes to pick from",
    "acknowledgement": "a statement about the person noted",
    "out_of_scope": "a polite 'only food' reply from the nutrition side",
    "invalid": "the message could not be read"
  },
