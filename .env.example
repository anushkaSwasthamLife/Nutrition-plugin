# Copy this file to .env (same folder) and edit. .env is never committed; only this example is.
# Lines starting with # are optional.

# --- Where the data is (see docs/SETUP.md) --------------------------------------------------------
# By default the project looks for a folder named "Nutrition" NEXT TO this project folder:
#   <parent>/Nutrition-plugin/            this project
#   <parent>/Nutrition/                   the data folder
# If yours is elsewhere, set the two paths below (full paths).
# DIXIT_NUTRITION_DIR=D:\work\Nutrition
# DIXIT_LIBRARY_DIR=D:\work\Nutrition\Swastham_Nutrition_Data_Library_v1_0_4

# --- Run mode -------------------------------------------------------------------------------------
DIXIT_ENVIRONMENT=development
DIXIT_PORT=8100
# DIXIT_DISH_LOOKUP=off        # off = skip the INDB dish answers ("calories in poha")
# DIXIT_VAR_DIR=               # where chat state and the audit log are written (default: ./var)

# --- AI wording (optional) ------------------------------------------------------------------------
# With no key the chat uses its plain template wording and still works. Numbers never come from the AI.
# Either point LLM_ENV_FILE at another .env that holds the LLM_* settings, or set them here.
LLM_ENV_FILE=
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
